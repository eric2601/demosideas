<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema base del sistema (ventana y splash). Los colores de la interfaz los
        define Compose en GastosTheme; aqui solo se fija el fondo para evitar el
        parpadeo blanco al abrir la aplicacion.
    -->
    <style name="Theme.ControlGastos" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
