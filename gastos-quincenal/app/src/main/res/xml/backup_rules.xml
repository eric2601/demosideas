<?xml version="1.0" encoding="utf-8"?>
<!--
    Copia de seguridad del sistema para Android 11 e inferiores.
    Se incluye la base de datos local para que el usuario no pierda su
    informacion al cambiar de dispositivo.
-->
<full-backup-content>
    <include domain="database" path="gastos_quincenal.db" />
    <include domain="database" path="gastos_quincenal.db-shm" />
    <include domain="database" path="gastos_quincenal.db-wal" />
</full-backup-content>
