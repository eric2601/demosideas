<?xml version="1.0" encoding="utf-8"?>
<!-- Reglas de copia y transferencia para Android 12 y superiores. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="gastos_quincenal.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="gastos_quincenal.db" />
    </device-transfer>
</data-extraction-rules>
