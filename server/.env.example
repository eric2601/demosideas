# Copia este archivo a .env y ajusta los valores
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://almacen:almacen_dev@localhost:5432/almacen
# En producción usa un secreto aleatorio de 32+ caracteres:  openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-caracteres
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12
# Orígenes extra permitidos por CORS (separados por coma). El panel web servido por la API no lo necesita.
CORS_ORIGINS=
BACKUP_DIR=../backups
BACKUP_KEEP=14
