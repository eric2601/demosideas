    "@react-navigation/native-stack": "^7.21.0",
    "@types/react": "~19.0.10",
    "expo": "~53.0.0",
    "expo-build-properties": "~0.14.8",
    "expo-crypto": "~14.1.5",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3"
