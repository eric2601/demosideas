{
  "name": "pedidos-almacen-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "smoke": "tsx scripts/smoke.ts",
    "export:android": "expo export --platform android",
    "doctor": "expo-doctor",
    "build:preview": "eas build -p android --profile preview",
    "build:production": "eas build -p android --profile production",
    "prebuild:android": "expo prebuild --platform android",
    "build:local": "expo prebuild --platform android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
