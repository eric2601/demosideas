<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Tema base de la Activity. La UI es Jetpack Compose (Material 3), por lo que este
        tema solo define el color de las barras del sistema y evita el ActionBar clasico.
        DayNight permite que el sistema aplique claro/oscuro antes de que Compose se infle.
    -->
    <style name="Theme.QAReportGenerator" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/qa_window_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>
</resources>
